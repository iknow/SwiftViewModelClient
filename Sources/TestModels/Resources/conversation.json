{"data":{"id":"1cea976e-238f-11ee-ac1a-5b1d41839835","_type":"RolePlay.Conversation","_version":2,"user":{"_ref":"ref:h:zdOHPWKWKSIqtPC/K29iwlYGOTQV76/4YDgfb8begLQ="},"scenario":{"_ref":"ref:h:t1ozuzGCL25h/uqrs3k0zrMSR+5hXhrvZqplVf5JMaE="},"exchanges":[{"id":"26abcd4a-238f-11ee-a37b-a33691c3c047","_type":"RolePlay.ConversationExchange","_version":5,"user_request":"Can I go to the bathroom after I go through the security checkpoint?","assistant_response":"Yes, of course! There are restrooms available both before and after the security checkpoint. Just make sure to leave yourself enough time to go through security again before your flight. Is there anything else I can help you with?","request_feedback":"Your reply is natural and grammatically correct. Well done!","response_translation":"はい、もちろんです！セキュリティチェックポイントの前後にトイレがあります。ただ、フライトの出発前に再びセキュリティを通るために時間に余裕をもって行ってください。他に何かお手伝いできることはありますか？","response_translation_language":"ja","total_tokens":228,"truncated":false,"used_hint":false,"reply_hints":[],"recording":null,"created_at":"2023-07-16T04:13:43.114603Z"},{"id":"38c69fd2-238f-11ee-b92d-af9c0d97ab4a","_type":"RolePlay.ConversationExchange","_version":5,"user_request":"How much water can I take through security?","assistant_response":"You are allowed to bring small quantities of liquids through security, with each container not exceeding 100 milliliters (3.4 ounces). These containers should be placed in a clear, resealable plastic bag, with a maximum capacity of 1 liter. Please note that there may be additional restrictions on carrying liquids on board, depending on the regulations of your destination. Is there anything else I can assist you with?","request_feedback":null,"response_translation":null,"response_translation_language":null,"total_tokens":322,"truncated":false,"used_hint":false,"reply_hints":[],"recording":null,"created_at":"2023-07-16T04:14:13.489320Z"}],"assistant_greeting":"Good morning! How can I assist you today?","greeting_translation":"おはようございます！今日は何かお手伝いできますか？","greeting_translation_language":"ja","complete":false,"rating":null,"feedback":null,"created_at":"2023-07-16T04:13:26.748405Z","updated_at":"2023-07-16T04:14:10.555823Z","lock_version":3,"_migrated":true},"references":{"ref:h:BzuyNp2lx8z5nFsSvkL0sD9zZDSLF6HAr2U1vISvaQ0=":{"id":"5a4657f2-e151-4c48-9cce-000000000002","_type":"BrandReference","_version":4,"name":{"id":"5a4657f2-e151-4c48-9cce-000000000002","_type":"Text","_version":2,"text":"Engoo Global","formatted":false,"lock_version":1,"text_translations":[]},"default_language":"en","logo":{"id":"f89f2959-bc02-49a6-b065-fbc1021c55ab","_type":"BrandLogo","_version":1,"url":"https://assets.app.engoo.com/logos/2FpaQO4zsyNdSYuaGUXYwH.png","lock_version":0},"square_logo":{"id":"8d45e272-f6a1-4a1b-8be6-e9909f9cd97c","_type":"BrandLogo","_version":1,"url":"https://assets.app.engoo.com/logos/4CQi347ZvLDo3BYPev3tz2.svg","lock_version":0},"organization":{"_ref":"ref:h:oI+p5o4izxSAkGbYXfKg/ZTz73tNlIfiwDUtrdN3jHE="}},"ref:h:oI+p5o4izxSAkGbYXfKg/ZTz73tNlIfiwDUtrdN3jHE=":{"id":"5d2656f1-9162-461d-88c7-b2505623d8cb","_type":"OrganizationReference","_version":3,"company_name":"DMM Eikaiwa Group","shares_materials":true},"ref:h:t1ozuzGCL25h/uqrs3k0zrMSR+5hXhrvZqplVf5JMaE=":{"id":"7562a491-f702-0adf-65fa-4ef0f40ca112","_type":"RolePlay.Scenario","_version":3,"owner":{"_ref":"ref:h:oI+p5o4izxSAkGbYXfKg/ZTz73tNlIfiwDUtrdN3jHE="},"name":{"id":"b537ccd6-328e-11ee-9ccb-5336181af965","_type":"Text","_version":2,"text":"Check in for a flight","formatted":false,"lock_version":0,"text_translations":[{"id":"b5382ff0-328e-11ee-9ccc-0ba74335acf7","_type":"TextTranslation","_version":2,"translation":"フライトのチェックイン","lock_version":0,"language":"ja"},{"id":"f10a9e68-624c-4684-9385-48f2fb524815","_type":"TextTranslation","_version":2,"translation":"เช็คอินเที่ยวบิน","lock_version":0,"language":"th"},{"id":"8005dbb2-332b-4d99-a879-41c5b0522d42","_type":"TextTranslation","_version":2,"translation":"탑승 수속 밟기","lock_version":0,"language":"ko"},